# ============================================================
# The Reel Ledger — environment variables
#
# Copy to .env for local work; set the same names in the Vercel project
# (Settings -> Environment Variables) and as GitHub Actions secrets.
# Every value here is server-side only. Nothing in this file may be
# prefixed VITE_ or referenced from frontend/ — that would ship it to
# the browser.
# ============================================================

# ---------- core ----------
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
GOOGLE_SERVICE_ACCOUNT_JSON={}
RUN_TOKEN=
CORS_ORIGINS=https://reels-dashboard-omega.vercel.app


# ============================================================
# Snapchat Public Profile API
# ============================================================

# ---------- the only secret this app really needs in the environment ----------
# Encrypts the OAuth tokens AND the credential vault below. REQUIRED in
# production: the key that opens the vault cannot itself live in the vault.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SNAPCHAT_ENCRYPTION_KEY=


# ---------- Snapchat OAuth app: prefer the vault over these ----------
# These now live encrypted in Postgres (table app_credentials), so they can be
# rotated without a redeploy and every runtime reads the same value:
#
#   curl -X PUT "$BASE/api/admin/credentials/snapchat_client_secret"
#     -H "X-Run-Token: $RUN_TOKEN" -H 'Content-Type: application/json'
#     -d '{"value":"<new secret>"}'
#
# The variables below remain a fallback for local work and for bootstrapping a
# fresh database. Leave them empty once the vault is populated. Resolution is
# vault first, environment second; GET /api/admin/credentials shows which one
# is in use for each key.
#
# Create the OAuth app in Snapchat Ads Manager -> Business Dashboard. NOT the
# Snap Developer Portal: Snap's docs state a client ID created there will not
# work with the Public Profile API.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# Must match the redirect URI registered on the OAuth app character for
# character. This is the production callback for this deployment.
SNAPCHAT_REDIRECT_URI=https://reels-dashboard-omega.vercel.app/api/snapchat/oauth/callback


# ---------- Snapchat tuning (all optional; defaults shown) ----------

# How long a resolved credential is cached in-process before the vault is
# re-read. A rotation invalidates the cache immediately, so this only bounds
# a change made directly in the database.
# CREDENTIAL_CACHE_TTL=60

# Bounds how long an unreachable database can hold a request open.
# DB_CONNECT_TIMEOUT=10

# Spotlight locale when a job does not set one. Required by Snap's API.
# SNAP_DEFAULT_LOCALE=en_US

# Verify the token's own profile matches the account row before publishing.
# Costs one extra API call per publish and is what stops one account's
# credentials being used against another's profile. Set to 0 only to debug.
# SNAP_VERIFY_PROFILE=1

# Retry policy for the scheduler.
# SNAP_MAX_ATTEMPTS=3
# SNAP_RETRY_COOLDOWN_MINUTES=30
# SNAP_BATCH_LIMIT=20

# Refresh the access token this many seconds before it expires, so a long
# upload never starts on a token that dies mid-flight.
# SNAP_TOKEN_REFRESH_MARGIN=300

# HTTP behaviour against businessapi.snapchat.com.
# SNAP_API_BASE=https://businessapi.snapchat.com
# SNAP_API_TIMEOUT=60
# SNAP_UPLOAD_TIMEOUT=300
# SNAP_HTTP_RETRIES=2
# SNAP_HTTP_BACKOFF=2
# SNAP_OAUTH_TIMEOUT=30


# ============================================================
# frontend/.env.local — browser-visible, no secrets
# ============================================================
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>
# VITE_API_URL=            # empty: the API is same-origin on Vercel
